^SERIES = GSE208261
!Series_title = Profiles of Pelvic organ prolapse [mRNA-seq, lncRNA-seq, circRNA-seq]
!Series_geo_accession = GSE208261
!Series_status = Public on Sep 05 2022
!Series_submission_date = Jul 14 2022
!Series_last_update_date = Dec 06 2022
!Series_pubmed_id = 36176289
!Series_summary = Pelvic organ prolapse (POP) affects a large proportion of adult women. With the increase in global population ageing, the prevalence of POP is expected to increase in upcoming decades, which will impose a substantial medical burden. Therefore, suitable therapeutical target is important. However, due to the pathogenesis of POP is still unclear, it leads to the failure of POP repair. Herein, we identified changes in ncRNA, and mRNAs in the anterior vaginal wall and uterosacral ligament in patients with POP, providing new insights into the pathogenesis of POP and new targets for treatment.
!Series_overall_design = Anterior vaginal wall and uterosacral ligaments were subjected to RNA sequencing
!Series_type = Expression profiling by high throughput sequencing
!Series_type = Non-coding RNA profiling by high throughput sequencing
!Series_contributor = Xia,,Yu
